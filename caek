-- CFrame.lookAt hands back a NaN CFrame when the two points coincide, and a
-- NaN root part is thrown straight out of the world.
local function safeLookAt(from, to)
    if not to or (to - from).Magnitude < 0.1 then
        return CFrame.new(from)
    end
    return CFrame.lookAt(from, to)
end

