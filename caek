-- ====================================================================
-- 1. MOUNTAIN MAP - measured, not guessed
-- ====================================================================
-- The cake is CakeConfig.ZoneCount stacked cylinders. Each step's top sits
-- one (height / zones) slice above the last, and each step is narrower than
-- the one below it. Both numbers are read off the live terrain with rays so
-- the map stays correct after a reroll or after players chew into it.
local Map = {
    cx = 0, cz = 0, height = 648, maxR = 528,
    zones = 6, step = 108, baseY = 0, topY = 648,
    axis = "height", isFlat = false,
    layers = {},          -- [k] = { topY = number, radius = number }
    stamp = "",
    at = 0,
}

local function rayParams()
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { lp.Character, miniCakes }
    return rp
end

function Map.groundY(x, z)
    local hit = Workspace:Raycast(
        Vector3.new(x, Map.height + 150, z),
        Vector3.new(0, -(Map.height + 450), 0),
        rayParams()
    )
    return hit and hit.Position.Y or nil
end

-- Outermost radius on a given bearing whose ground still reaches wantY.
local function edgeRadius(wantY, angle)
    local lo, hi = 0, Map.maxR + 30
    for _ = 1, 11 do
        local mid = (lo + hi) * 0.5
        local gy = Map.groundY(Map.cx + math.cos(angle) * mid, Map.cz + math.sin(angle) * mid)
        if gy and gy >= wantY - 20 then lo = mid else hi = mid end
    end
    return lo
end

function Map.refresh(force)
    local cakeId = tostring(ReplicatedStorage:GetAttribute("CurrentCakeId") or "")
    local axis = ReplicatedStorage:GetAttribute("CurrentCakeAxis")
    if not axis and cakeId ~= "" then
        local ok, a = pcall(CakeConfig.cakeAxis, cakeId)
        if ok and a then axis = a end
    end
    axis = axis or "height"

    local stamp = table.concat({
        cakeId,
        tostring(ReplicatedStorage:GetAttribute("CurrentCakeHeight")),
        tostring(ReplicatedStorage:GetAttribute("CurrentCakeMaxRadius")),
        axis,
    }, "|")
    if not force and stamp == Map.stamp and (os.clock() - Map.at) < 45 then return end

    Map.cx = ReplicatedStorage:GetAttribute("CurrentCakeCenterX") or 0
    Map.cz = ReplicatedStorage:GetAttribute("CurrentCakeCenterZ") or 0
    Map.height = ReplicatedStorage:GetAttribute("CurrentCakeHeight") or 648
    Map.maxR = ReplicatedStorage:GetAttribute("CurrentCakeMaxRadius") or 528
    Map.zones = CakeConfig.ZoneCount or 6
    Map.step = Map.height / Map.zones
    Map.baseY = Map.groundY(Map.cx + Map.maxR + 60, Map.cz) or 0
    Map.axis = axis
    Map.isFlat = (axis == "core")

    if Map.isFlat then
        -- On flat cake (e.g. Pancake, Lemon Tart, Blueberry Cheese, Tiramisu),
        -- the top is a wide plateau at cake height. Zones are concentric rings
        -- from outer rim (Zone 1) to core center (Zone 6).
        Map.topY = Map.groundY(Map.cx, Map.cz) or (Map.baseY + Map.height)
        local layers = {}
        for k = 1, Map.zones do
            local zfMid = ((k - 1) + 0.5) / Map.zones
            local r = (1 - zfMid) * Map.maxR
            layers[k] = { topY = Map.topY, radius = r }
        end
        layers[0] = { topY = Map.baseY, radius = Map.maxR + 100 }
        Map.layers = layers
    else
        local layers = {}
        for k = 1, Map.zones do
            local wantY = Map.step * k
            local samples = {}
            for a = 0, 5 do
                samples[#samples + 1] = edgeRadius(wantY, math.rad(a * 60))
            end
            table.sort(samples)
            local radius = (samples[3] + samples[4]) * 0.5
            -- read the plateau height back off the terrain just inside that edge
            local topY = Map.groundY(Map.cx + math.max(radius - 12, 0), Map.cz) or (Map.baseY + wantY)
            layers[k] = { topY = topY, radius = radius }
        end
        -- layer 0 is the flat ground ringing the mountain
        layers[0] = { topY = Map.baseY, radius = Map.maxR + 200 }
        Map.layers = layers
        Map.topY = layers[Map.zones] and layers[Map.zones].topY or (Map.baseY + Map.height)
    end
    Map.stamp = stamp
    Map.at = os.clock()
end

function Map.maxDigY()
    local tier = tonumber(lp:GetAttribute("SpoonTier")) or 1
    local zf = CakeConfig.spoonGateZf(tier)
    if zf == math.huge then return math.huge end
    return zf * Map.height
end

function Map.spoonZone()
    local tier = tonumber(lp:GetAttribute("SpoonTier")) or 1
    local ok, z = pcall(CakeConfig.spoonZone, tier)
    return (ok and z) or 1
end

function Map.targetZone()
    if S.TargetZone == "Auto (Max Spoon)" then return Map.spoonZone() end
    local n = tonumber(S.TargetZone:match("Zone (%d+)"))
    return math.clamp(n or 1, 1, Map.zones)
end

-- Which plateau do we stand on to chew the wall of the target zone?
function Map.standLayer()
    local z = Map.targetZone()
    return math.clamp(z - 1, 0, Map.zones - 1)
end

-- Park against the wall of the step above, or on the target zone ring of flat cake.
local MAX_RECESS = 90

function Map.wallSpot(angle)
    if Map.isFlat then
        -- On flat mountain, park directly on top of the cake inside the target zone ring.
        local z = Map.targetZone()
        local zfMin = (z - 1) / Map.zones
        local zfMax = z / Map.zones
        local zfMid = (zfMin + zfMax) * 0.5
        -- zf = 1 - (dist / maxR) => dist = (1 - zf) * maxR
        local targetRadius = math.clamp((1 - zfMid) * Map.maxR, 20, Map.maxR - 15)

        local sx = Map.cx + math.cos(angle) * targetRadius
        local sz = Map.cz + math.sin(angle) * targetRadius
        local sy = Map.groundY(sx, sz) or Map.topY
        if sy < Map.baseY - 10 then sy = Map.topY end

        return Vector3.new(sx, sy + 3.2, sz), sy, targetRadius
    end

    local k = Map.standLayer()
    local floor = Map.layers[k]
    local above = Map.layers[k + 1]
    if not floor then return nil end

    local plateauY = floor.topY

    -- Top step has nothing above it: dig down into the summit instead.
    if not above then
        local radius = math.max(floor.radius * 0.5, 30)
        local x = Map.cx + math.cos(angle) * radius
        local z = Map.cz + math.sin(angle) * radius
        local gy = Map.groundY(x, z) or plateauY
        return Vector3.new(x, gy + 3.5, z), plateauY, radius
    end

    local start = above.radius + 20
    for r = start, math.max(above.radius - MAX_RECESS, 20), -4 do
        local x = Map.cx + math.cos(angle) * r
        local z = Map.cz + math.sin(angle) * r
        local gy = Map.groundY(x, z)
        if gy and gy > plateauY + 25 then
            -- Wall face is at r; stand just outside it on the plateau.
            local stand = r + 11
            local sx = Map.cx + math.cos(angle) * stand
            local sz = Map.cz + math.sin(angle) * stand
            local sy = Map.groundY(sx, sz)
            if sy and math.abs(sy - plateauY) < 30 then
                return Vector3.new(sx, sy + 3.5, sz), plateauY, stand
            end
        end
    end
    return nil, plateauY, nil
end

Map.refresh(true)

-- ====================================================================
-- 2. MOVEMENT - straight-line walking plus wall lifts
-- ====================================================================
-- PathfindingService is deliberately not used here. Measured on this map it
-- returns NoPath for every target above the current step (the walls are sheer)
-- and burns 0.5-9s per query even when it does succeed.
local Nav = {}

local function applyWalkSpeed()
    local hum = getHum()
    if hum and hum.WalkSpeed ~= S.WalkSpeed then
        hum.WalkSpeed = S.WalkSpeed
    end
end

local gliding = false

task.spawn(function()
    while isRunning do
        pcall(applyWalkSpeed)
        -- Safety net: an anchored root that outlives a glide freezes the run.
        pcall(function()
            local hrp = getHRP()
            if hrp and hrp.Anchored and not gliding then hrp.Anchored = false end
        end)
        task.wait(1.0)
    end
end)
lp.CharacterAdded:Connect(function()
    task.wait(0.6)
    pcall(applyWalkSpeed)
end)

-- Drop a point onto solid ground. Landing inside terrain gets the character
-- ejected hard enough to throw it under the map, so a spot we cannot stand on
-- is refused outright rather than guessed at.
local function settle(pos)
    local hit = Workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -160, 0), rayParams())
    if hit then
        return hit.Position + Vector3.new(0, 3.2, 0)
    end
    local gy = Map.groundY(pos.X, pos.Z)
    if gy and math.abs(gy - pos.Y) < 200 then
        return Vector3.new(pos.X, gy + 3.2, pos.Z)
    end
    return nil
end

-- Reposition the root part. "Smooth Hop" splits the move into steps that stay
-- inside the server's own movement allowances; "Instant" goes in one write.
function Nav.blink(targetPos, faceCenter)
    local hrp = getHRP()
    if not hrp then return false end
    if S.MoveMode == "Walk Only" then return false end

    local dest = settle(targetPos)
    if not dest or dest.Y < 0 or dest.Y > Map.height + 120 then return false end

    -- Two glides at once would fight over the anchor and strand the character.
    local mode = S.MoveMode
    if gliding then mode = "Instant" end

    local look = faceCenter and Vector3.new(Map.cx, dest.Y, Map.cz) or (dest + hrp.CFrame.LookVector * 5)

    if mode == "Smooth Hop" then
        -- Glide there at a fixed rate instead of jumping. The root is held
        -- still for the trip: stepping an unheld character leaves it falling
        -- between steps, which turns a 40-stud step into a 200-stud one.
        local speed = math.max(S.HopStep, 10) * 2
        gliding = true
        hrp.Anchored = true
        local guard = os.clock()
        while isRunning do
            local cur = getHRP()
            if not cur then break end
            local remaining = dest - cur.Position
            local left = remaining.Magnitude
            if left <= 2 or os.clock() - guard > 25 then break end
            cur.CFrame = CFrame.new(cur.Position + remaining.Unit * math.min(speed * 0.05, left))
            task.wait(0.05)
        end
        gliding = false
        local cur = getHRP()
        if cur then cur.Anchored = false end
    end

    local cur = getHRP()
    if not cur then return false end
    cur.CFrame = safeLookAt(dest, look)
    task.wait(0.25)
    return true
end

-- Plain humanoid walking. Flat plateaus have nothing to route around, so a
-- re-asserted MoveTo beats any waypoint list, and we bail the moment we stall.
function Nav.walkTo(targetPos, stopDist, maxTime)
    stopDist = stopDist or 5
    maxTime = maxTime or 8
    navId = navId + 1
    local myId = navId

    local hum, hrp = getHum(), getHRP()
    if not hum or not hrp then return false end

    local t0 = os.clock()
    local lastPos = hrp.Position
    local lastProgress = t0

    while os.clock() - t0 < maxTime do
        if navId ~= myId or not isRunning or isFlushing then return false end
        local cur = getHRP()
        if not cur then return false end

        if (targetPos - cur.Position).Magnitude <= stopDist then return true end

        hum:MoveTo(targetPos)

        if (cur.Position - lastPos).Magnitude > 1.2 then
            lastPos = cur.Position
            lastProgress = os.clock()
        elseif os.clock() - lastProgress > 0.9 then
            hum.Jump = true
            if os.clock() - lastProgress > 2.0 then return false end
        end
        task.wait(0.1)
    end
    local cur = getHRP()
    return cur and (targetPos - cur.Position).Magnitude <= stopDist
end

-- The one entry point the rest of the hub uses.
function Nav.travelTo(targetPos, stopDist, faceCenter)
    local hrp = getHRP()
    if not hrp then return false end
    stopDist = stopDist or 6

    if (targetPos - hrp.Position).Magnitude <= stopDist then return true end

    local dy = targetPos.Y - hrp.Position.Y
    local flat = flatDist(targetPos, hrp.Position)

    -- Same step, walkable distance: use the legs.
    if math.abs(dy) <= 8 and flat <= S.WalkRange then
        if Nav.walkTo(targetPos, stopDist, 10) then return true end
    end

    if S.MoveMode == "Walk Only" then
        -- No lift allowed. Only reachable if it happens to be on our step.
        return Nav.walkTo(targetPos, stopDist, 14)
    end

    -- Different step, or walking stalled: lift over the wall, then close in.
    Nav.blink(targetPos, faceCenter)
    local cur = getHRP()
    if cur and (targetPos - cur.Position).Magnitude > stopDist then
        Nav.walkTo(targetPos, stopDist, 4)
    end
    cur = getHRP()
    return cur ~= nil and (targetPos - cur.Position).Magnitude <= stopDist + 4
end

