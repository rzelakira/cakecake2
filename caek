-- ====================================================================
-- 4. DIGGING
-- ====================================================================
-- The server only accepts a bite below spoonGateZf(tier) * cake height, and
-- only within MaxDigDistance plus a speed allowance. Both are read live so an
-- upgrade widens the reach on its own.
-- digMax() grows with the character's speed, but the server recomputes it from
-- whatever velocity it sees when the request lands. Trusting the bonus makes a
-- share of the bites land out of range and get dropped, so we stay inside the
-- flat allowance and every bite counts.
local function digReach()
    local base = CakeConfig.MaxDigDistance or 16
    return base - 1.5
end

local function isBiteLegal(pos)
    local fullness = tonumber(lp:GetAttribute("Fullness")) or 0
    if fullness >= 0.999 then return false end
    local ok, allowed = pcall(
        CakeConfig.gateAllowed,
        Map.axis or ReplicatedStorage:GetAttribute("CurrentCakeAxis") or "height",
        tonumber(lp:GetAttribute("SpoonTier")) or 1,
        pos,
        Map.height,
        Map.maxR,
        Map.cx,
        Map.cz
    )
    return ok and allowed
end

-- Pick the HIGHEST legal bite on stepped wall, or closest legal bite on flat cake.
local function findBite()
    local hrp = getHRP()
    if not hrp then return nil end
    local reach = digReach()
    local eye = hrp.Position + Vector3.new(0, 1.4, 0)
    local L = hrp.CFrame.LookVector
    local R = hrp.CFrame.RightVector
    local rp = rayParams()

    -- The wall is always the way the mountain narrows, so aim inward as well as
    -- forward. Facing drifts every time the humanoid takes a step; the inward
    -- direction does not, and it keeps the bites landing while we shuffle.
    local flat = Vector3.new(Map.cx - hrp.Position.X, 0, Map.cz - hrp.Position.Z)
    local C = flat.Magnitude > 1 and flat.Unit or L

    local dirs
    if Map.isFlat then
        -- On flat cake, chew downwards into the ground and pocket in front/inward
        dirs = {
            Vector3.new(0, -1, 0), -- straight down beneath feet
            (L + Vector3.new(0, -0.6, 0)).Unit,
            (L + Vector3.new(0, -1.2, 0)).Unit,
            (C + Vector3.new(0, -0.6, 0)).Unit,
            (C + Vector3.new(0, -1.2, 0)).Unit,
            (L + R * 0.4 + Vector3.new(0, -0.8, 0)).Unit,
            (L - R * 0.4 + Vector3.new(0, -0.8, 0)).Unit,
            (C + R * 0.4 + Vector3.new(0, -0.8, 0)).Unit,
            (C - R * 0.4 + Vector3.new(0, -0.8, 0)).Unit,
            L,
            C,
        }
    else
        dirs = {
            (C + Vector3.new(0, 0.9, 0)).Unit,
            (C + Vector3.new(0, 0.5, 0)).Unit,
            (C + Vector3.new(0, 0.22, 0)).Unit,
            C,
            (L + Vector3.new(0, 0.9, 0)).Unit,
            (L + Vector3.new(0, 0.5, 0)).Unit,
            L,
            (L + R * 0.35 + Vector3.new(0, 0.5, 0)).Unit,
            (L - R * 0.35 + Vector3.new(0, 0.5, 0)).Unit,
            (C + Vector3.new(0, -0.45, 0)).Unit,
        }
    end

    local capY = Map.isFlat and math.huge or (Map.maxDigY() - 1)

    local best = nil
    for _, dir in ipairs(dirs) do
        local hit = Workspace:Raycast(eye, dir * (reach + 10), rp)
        if hit and hit.Instance == Workspace.Terrain and hit.Position.Y < capY then
            local d = (hit.Position - hrp.Position).Magnitude
            if d <= reach and isBiteLegal(hit.Position) then
                if not best then
                    best = hit
                elseif Map.isFlat then
                    -- On flat cake, prefer closest bite in reach so we chew pocket cleanly
                    if d < (best.Position - hrp.Position).Magnitude then
                        best = hit
                    end
                else
                    -- Stepped mountain: prefer highest Y on wall
                    if hit.Position.Y > best.Position.Y then
                        best = hit
                    end
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while isRunning do
        if S.AutoSpoon and not isFlushing and not isCollecting then
            local fullness = tonumber(lp:GetAttribute("Fullness")) or 0
            if fullness < 0.999 then
                local hit = findBite()
                if hit and isBiteLegal(hit.Position) then
                    digRequest:FireServer(hit.Position, hit.Normal)
                    Stats.bites = Stats.bites + 1
                else
                    Stats.dry = Stats.dry + 1
                end
            end
        end
        -- The game enforces its own cooldown and lowers it as the scoop levels
        -- up; firing under it is a wasted call, so track the live value.
        local cd = tonumber(lp:GetAttribute("DigCooldown")) or 0.4
        task.wait(math.max(S.SpoonDelay, cd + 0.03))
    end
end)

-- ====================================================================
-- 5. MINI CAKE COLLECTION
-- ====================================================================
-- A cake buried inside the mountain has its prompt switched off by the server;
-- 2 in 3 of them are buried at any moment. Ignoring that flag is what sends a
-- bot marching at cakes it can never pick up.
-- Rarity list and ordering come from CakeConfig.Rarities so a new tier added by
-- the game shows up in the filter on its own. Score is the game's own
-- valuePerKg, so the ranking never drifts from what a cake is actually worth.
local RARITY_ORDER, RARITY_WEIGHT = {}, {}
do
    local rs = CakeConfig.Rarities
    if type(rs) == "table" and #rs > 0 then
        for i, r in ipairs(rs) do
            local name = type(r) == "table" and r.name or tostring(r)
            RARITY_ORDER[i] = name
            RARITY_WEIGHT[name] = math.max(2, (type(r) == "table" and r.valuePerKg or 10) / 40)
        end
    else
        RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }
        RARITY_WEIGHT = { Common = 2, Uncommon = 6, Rare = 14, Epic = 30, Legendary = 70, Mythic = 160 }
    end
    for _, name in ipairs(RARITY_ORDER) do
        S.TargetRarities[name] = true
    end
end

-- Fresh copy each call: Sena keeps a reference to whatever list it is handed.
local function rarityList()
    local t = {}
    for i, name in ipairs(RARITY_ORDER) do t[i] = name end
    return t
end

-- bandY keeps the search on the layer we are farming. Without it the bot gets
-- towed down to the cheap cakes ringing the base and never climbs back.
local function findCake(bandY)
    local hrp = getHRP()
    if not hrp then return nil end

    local best, bestScore = nil, -math.huge
    for _, model in ipairs(miniCakes:GetChildren()) do
        local rarity, id = model.Name:match("MiniCake_(%w+)_(Cake_[%w_]+)")
        if rarity and id and not (skipCache[model] and os.clock() - skipCache[model] < 25) then
            local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled and prompt.Parent and prompt.Parent:IsA("BasePart") then
                local uncollected = (collectedMap[id] == nil)
                if S.TargetRarities[rarity] or (S.PrioritizeUncollected and uncollected) then
                    local part = prompt.Parent
                    local dist = (part.Position - hrp.Position).Magnitude
                    local inBand
                    if Map.isFlat then
                        inBand = (not bandY) or (part.Position.Y >= Map.baseY - 10 and part.Position.Y <= Map.topY + 60)
                    else
                        inBand = (not bandY) or math.abs(part.Position.Y - bandY) <= 70
                    end
                    if dist <= S.CollectRange and inBand then
                        local score = (RARITY_WEIGHT[rarity] or 2)
                            + (uncollected and 80 or 0)
                            - dist * 0.35
                        if score > bestScore then
                            bestScore = score
                            best = { model = model, part = part, prompt = prompt, id = id, dist = dist }
                        end
                    end
                end
            end
        end
    end
    return best
end

-- fireproximityprompt does not reach the server for these prompts; a held key
-- event does. Hold length comes off the prompt itself - big cakes ask for
-- nearly four seconds.
local function collectCake(cake)
    if not cake or cake.model.Parent ~= miniCakes then return false end
    local hrp = getHRP()
    if not hrp then return false end

    isCollecting = true
    local hold = (cake.prompt.HoldDuration or 1.5) + 0.5

    hrp.CFrame = safeLookAt(hrp.Position, Vector3.new(cake.part.Position.X, hrp.Position.Y, cake.part.Position.Z))
    task.wait(0.15)

    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(hold)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

    for _ = 1, 8 do
        task.wait(0.2)
        if cake.model.Parent ~= miniCakes then break end
    end

    isCollecting = false
    local got = cake.model.Parent ~= miniCakes
    if got then Stats.collects = Stats.collects + 1 else skipCache[cake.model] = os.clock() end
    return got
end

-- ====================================================================
-- 6. FARM LOOP
-- ====================================================================
-- The loop is deliberately biased towards staying put and biting. Repositioning
-- is the expensive move here: it throws away the pocket already carved and
-- leaves the fresh wall out of reach, so it only happens once the current post
-- has actually stopped producing.
local dryStreak = 0

task.spawn(function()
    while isRunning do
        if S.AutoWalk and not isFlushing and not isCollecting then
            local ok = pcall(function()
                Map.refresh(false)
                local hrp = getHRP()
                local hum = getHum()
                if not hrp or not hum then return end

                local _, plateauY = Map.wallSpot(farmAngle)
                plateauY = plateauY or hrp.Position.Y

                -- Off-band means the post is useless: either we dropped down a
                -- hole, or we are sitting on a step whose surface is already
                -- above what the spoon is allowed to touch, where every single
                -- bite gets refused.
                local y = hrp.Position.Y
                local ceiling = Map.maxDigY()
                local fellOff
                if Map.isFlat then
                    local dCenter = flatDist(hrp.Position, Vector3.new(Map.cx, 0, Map.cz))
                    fellOff = (dCenter > Map.maxR + 35) or (y < Map.baseY - 5)
                else
                    fellOff = y < plateauY - 70
                        or y > plateauY + 35
                        or (ceiling ~= math.huge and y > ceiling + 8)
                end

                -- Free pickups first: anything already inside arm's reach.
                if S.AutoCollect then
                    local cake = findCake(plateauY)
                    if cake then
                        local reach = math.max((cake.prompt.MaxActivationDistance or 13) - 3, 5)
                        if cake.dist <= reach then
                            collectCake(cake)
                            return
                        end
                        -- Worth walking for only if it is close and on our step.
                        if not fellOff and cake.dist <= 90 then
                            local approach = cake.part.Position + Vector3.new(0, 3, 0)
                            if Nav.travelTo(approach, reach) then
                                local cur = getHRP()
                                if cur and (cake.part.Position - cur.Position).Magnitude <= reach + 3 then
                                    collectCake(cake)
                                end
                            else
                                skipCache[cake.model] = os.clock()
                            end
                            return
                        end
                    end
                end

                -- Still chewing? Then we are exactly where we want to be.
                if not fellOff and findBite() then
                    dryStreak = 0
                    task.wait(0.2)
                    return
                end

                -- Nothing in reach. Step into the pocket we just carved.
                if not fellOff then
                    local before = hrp.Position
                    hum:MoveTo(hrp.Position + hrp.CFrame.LookVector * 6)
                    task.wait(0.4)
                    if (hrp.Position - before).Magnitude >= 1.5 then
                        Stats.advances = Stats.advances + 1
                        dryStreak = 0
                        return
                    end
                end

                dryStreak = dryStreak + 1
                if dryStreak < 3 and not fellOff then
                    -- Slide a little way along the wall/ring and try again.
                    Stats.slides = Stats.slides + 1
                    farmAngle = farmAngle + (Map.isFlat and 0.08 or 0.05)
                    local slide = Map.wallSpot(farmAngle)
                    if slide then
                        hum:MoveTo(slide)
                        task.wait(0.4)
                        local cur = getHRP()
                        if cur then
                            cur.CFrame = safeLookAt(cur.Position, Vector3.new(Map.cx, cur.Position.Y, Map.cz))
                        end
                    end
                    return
                end

                -- Post is spent (or we dropped off the step). Find fresh wall.
                dryStreak = 0
                Stats.moves = Stats.moves + 1
                local spot
                for _ = 1, 12 do
                    farmAngle = (farmAngle + 0.45) % (math.pi * 2)
                    spot = Map.wallSpot(farmAngle)
                    if spot then break end
                end
                if spot then
                    Nav.travelTo(spot, 8, true)
                    local cur = getHRP()
                    if cur then
                        cur.CFrame = safeLookAt(cur.Position, Vector3.new(Map.cx, cur.Position.Y, Map.cz))
                    end
                end
            end)
            if not ok then task.wait(0.5) end
        end
        task.wait(0.15)
    end
end)

-- ====================================================================
-- 7. AUTO TOILET
-- ====================================================================
-- The flush runs a scripted sequence where the server seats the character,
-- swirls the bowl, empties fullness, and stands the character back up (~3.8s).
-- Returning before the unseat completes causes the seat weld to snap the player back.
local function findFlushPrompt()
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Name == "FlushPrompt" then
            return p, p.Parent
        end
    end
    return nil, nil
end

local function flushToilet()
    local hrp = getHRP()
    local hum = getHum()
    if not hrp or not hum then return false end

    local prompt, tank = findFlushPrompt()
    if not prompt or not tank then return false end

    local savedCF = hrp.CFrame

    -- Stand directly in front of the toilet
    local stand = tank.CFrame * CFrame.new(0, 0, -6)
    local WarpTo = ReplicatedStorage:FindFirstChild("WarpTo")
    if WarpTo then
        pcall(function()
            require(WarpTo).warp("toilet")
        end)
    end
    hrp.CFrame = CFrame.lookAt(stand.Position, tank.Position)
    task.wait(0.4)

    -- Trigger the flush prompt
    local t0 = os.clock()
    local triggered = false
    if fireproximityprompt then
        pcall(function()
            fireproximityprompt(prompt)
            triggered = true
        end)
    end
    if not triggered then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait((prompt.HoldDuration or 0.5) + 0.35)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end

    -- 1. Wait for flush sequence to start (player gets seated on the toilet)
    local tStart = os.clock()
    while os.clock() - tStart < 2.5 do
        if hum.Sit then break end
        task.wait(0.1)
    end

    -- 2. Wait for Fullness attribute to drain to 0
    local tDrain = os.clock()
    while os.clock() - tDrain < 6.0 do
        if (tonumber(lp:GetAttribute("Fullness")) or 0) < 0.01 then break end
        task.wait(0.15)
    end

    -- 3. Wait for the server sequence to stand the player back UP
    local tStand = os.clock()
    while os.clock() - tStand < 4.5 do
        if not hum.Sit then break end
        task.wait(0.15)
    end

    -- Safety: force unseat to break any lingering seat weld
    if hum.Sit then
        hum.Sit = false
        task.wait(0.2)
    end

    -- Respect any configured minimum return delay from trigger
    while os.clock() - t0 < (S.FlushReturnDelay or 4.5) do
        task.wait(0.1)
    end

    if not S.ReturnAfterFlush then return true end

    -- Verify fullness actually drained before returning!
    local finalFullness = tonumber(lp:GetAttribute("Fullness")) or 0
    if finalFullness >= 0.5 then
        -- Flush failed to drain fullness, do not return yet (prevents rapid warp ping-pong)
        return false
    end

    -- Return cleanly to farm spot
    for _ = 1, 3 do
        local cur = getHRP()
        if not cur then return true end
        cur.CFrame = savedCF
        task.wait(0.35)
        if (cur.Position - savedCF.Position).Magnitude < 15 then break end
    end
    return true
end

task.spawn(function()
    while isRunning do
        if S.AutoFlushOn100 and not isFlushing then
            local fullness = tonumber(lp:GetAttribute("Fullness")) or 0
            if fullness >= 0.999 then
                isFlushing = true
                navId = navId + 1
                pcall(flushToilet)
                Stats.flushes = Stats.flushes + 1
                task.wait(0.5)
                isFlushing = false
            end
        end
        task.wait(0.5)
    end
end)

