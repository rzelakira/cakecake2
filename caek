-- ====================================================================
-- 9. AUTO UPGRADE & SHOWCASE
-- ====================================================================
-- BuyUpgrade accepts "Spoon", "Arm", "Arm10", "Stomach" and "Legs". Verified
-- live: none of them check how far you are from the shop NPC, so the whole
-- shop works from up on the mountain without ever walking down.
--
-- There is no separate backpack upgrade - bag capacity is literally
-- BagBaseCapacity + ArmLevel (20 + level, confirmed against the live inventory
-- capacity), so Arm IS the backpack. "Arm10" buys ten at once but is priced
-- slightly worse per level than ten singles, so singles it is.
--
-- Legs is buyable too but only raises base walk speed, which this hub already
-- overrides, so buying it would burn crumbs for nothing. Deliberately absent.

local RESERVE_FRACTION = {
    ["Spend Everything"] = 0,
    ["Keep 25% for Spoon"] = 0.25,
    ["Keep 50% for Spoon"] = 0.50,
    ["Keep 75% for Spoon"] = 0.75,
}

local function crumbs()
    local n = lp:FindFirstChild("CrumbsNum")
    return n and n.Value or 0
end

local lastArmNotify = 0

local function stomachMax()
    local d = CakeConfig.DoctorUpgrades and CakeConfig.DoctorUpgrades.Stomach
    return (d and d.max) or 20
end

task.spawn(function()
    while isRunning do
        -- Spoon first: it is the only upgrade that unlocks deeper zones, so it
        -- gets the crumbs before anything else can nibble at them.
        if S.AutoUpgradeSpoon then
            local tier = tonumber(lp:GetAttribute("SpoonTier")) or 1
            local cost = CakeConfig.spoonCost(tier)
            if cost and cost > 0 and crumbs() >= cost then
                local s, res = pcall(function() return buyUpgrade:InvokeServer("Spoon") end)
                if s and res and res.ok then
                    Map.refresh(true)
                    Sena:Notify({
                        Title = "Spoon Upgraded",
                        Content = ("Tier %d - reaches zone %d now."):format(res.level or (tier + 1), Map.spoonZone()),
                        Icon = "sparkles",
                        Duration = 4,
                    })
                end
            end
        end

        local reserve = RESERVE_FRACTION[S.CrumbReserve] or 0.25
        local spendable = crumbs() * (1 - reserve)

        -- Stomach: fewer toilet trips. One level per pass, it is expensive.
        if S.AutoUpgradeStomach then
            local lvl = tonumber(lp:GetAttribute("StomachLvl")) or 0
            if lvl < stomachMax() then
                local cost = CakeConfig.doctorCost(lvl)
                if cost and cost > 0 and spendable >= cost then
                    local s, res = pcall(function() return buyUpgrade:InvokeServer("Stomach") end)
                    if s and res and res.ok then
                        spendable = spendable - cost
                        Sena:Notify({
                            Title = "Stomach Upgraded",
                            Content = ("Level %d of %d."):format(res.level or (lvl + 1), stomachMax()),
                            Icon = "arrow-up-circle",
                            Duration = 3,
                        })
                    end
                end
            end
        end

        -- Arm / bag capacity. Cheap per level, so buy as many as the budget
        -- covers; capped per pass so a big crumb pile does not turn into one
        -- long burst of remote calls.
        if S.AutoUpgradeArm then
            local bought = 0
            -- Track the level from the reply rather than re-reading the
            -- attribute: it replicates back slower than this loop buys, and a
            -- stale level prices the next one wrong.
            local lvl = tonumber(lp:GetAttribute("ArmLevel")) or 0
            for _ = 1, 20 do
                local cost = CakeConfig.armCost(lvl)
                if not cost or cost <= 0 or spendable < cost then break end
                local s, res = pcall(function() return buyUpgrade:InvokeServer("Arm") end)
                if not (s and res and res.ok) then break end
                lvl = tonumber(res.level) or (lvl + 1)
                spendable = spendable - cost
                bought = bought + 1
                task.wait(0.05)
            end
            if bought > 0 and os.clock() - lastArmNotify > 20 then
                lastArmNotify = os.clock()
                Sena:Notify({
                    Title = "Bag Upgraded",
                    Content = ("Arm level %d - bag holds %s kg."):format(lvl, CakeConfig.fmtNum(CakeConfig.bagCapacityFor(lvl))),
                    Icon = "backpack",
                    Duration = 3,
                })
            end
        end

        if S.AutoPlaceBest then
            pcall(function() autoDisplay:InvokeServer(S.PlaceMode) end)
        end
        task.wait(1.0)
    end
end)

