        local cap = Map.isFlat and "All Zones Open" or ("up to %.0f high"):format(Map.maxDigY() == math.huge and Map.height or Map.maxDigY())
        Sena:Notify({
            Title = ("%s Cake (%s)"):format(tostring(ReplicatedStorage:GetAttribute("CurrentCakeName") or "?"), Map.axis),
            Content = ("%s - %.0f tall, %d zones. Spoon reaches zone %d (%s)."):format(
                shapeStr, Map.height, Map.zones, Map.spoonZone(), cap),
            Icon = "info",
            Duration = 6,
        })
    end,
})

getgenv()._SenaCakeMountain = { Map = Map, Nav = Nav, S = S, Stats = Stats }

-- Register cleanup
getgenv()._SenaCakeMountainCleanup = function()
    isRunning = false
    gliding = false
    pcall(function() colConn:Disconnect() end)
    pcall(function()
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end)
    pcall(function()
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = CakeConfig.BaseWalkSpeed or 25 end
    end)
    pcall(function() Window:Destroy() end)
end

